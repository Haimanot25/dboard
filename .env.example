# Database URL for Prisma (application metadata)
DATABASE_URL="file:./dev.db"

# NextAuth.js
NEXTAUTH_SECRET="<generate-with: openssl rand -base64 32>"
NEXTAUTH_URL="http://localhost:3000"

# Encryption key for database passwords and API keys
ENCRYPTION_KEY="<generate-with: openssl rand -base64 32>"

# Allow connecting to private/internal database hosts (for local dev only)
# Set to "1" to allow localhost/private IPs; omit or set to "0" in production
ALLOW_PRIVATE_DB_HOSTS="0"

# Seed admin user (required for `npx prisma db seed`)
SEED_EMAIL="admin@dbboard.dev"
SEED_PASSWORD="<generate-with: openssl rand -base64 16>"